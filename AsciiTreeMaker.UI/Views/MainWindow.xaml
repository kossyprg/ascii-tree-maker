<Window x:Class="AsciiTreeMaker.UI.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:prism="http://prismlibrary.com/"
        xmlns:models="clr-namespace:AsciiTreeMaker.UI.Models"
        prism:ViewModelLocator.AutoWireViewModel="True"
        Title="{Binding Title}" 
        Height="500" 
        Width="525"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVisibilityConverter"/>
        
        <Style x:Key="ToolbarIconStyle" TargetType="Image">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Stretch" Value="Uniform"/>
        </Style>

        <!-- ツールバーのボタンが無効のとき見た目を変える -->
        <Style x:Key="ToolbarButtonStyle" TargetType="Button">
            <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <!-- ボタン全体を薄くする（中のImageも一緒に薄くなる） -->
                    <Setter Property="Opacity" Value="0.35"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <!--ショートカットキーの定義-->
    <Window.InputBindings>
        <KeyBinding Command="{Binding CreateNewCommand}"
                    Gesture="Ctrl+N" />
        <KeyBinding Command="{Binding OpenCommand}"
                    Gesture="Ctrl+O" />
        <KeyBinding Command="{Binding SaveCommand}"
                    Gesture="Ctrl+S"/>
        <KeyBinding Command="{Binding SaveAsCommand}"
                    Gesture="Ctrl+Shift+S"/>
    </Window.InputBindings>
    
    <Grid>
        <Grid.RowDefinitions>
            <!-- Menu -->
            <RowDefinition Height="Auto"/>
            <!--ToolBar-->
            <RowDefinition Height="Auto"/>
            <!--TreeView-->
            <RowDefinition Height="*"/>
            <!--(デバッグ時のみ)StatusBar-->
            <!--コードビハインドでHeightを調整-->
            <RowDefinition x:Name="StatusRow" Height="25"/>
        </Grid.RowDefinitions>

        <!-- Menu -->
        <Menu Grid.Row="0">
            <MenuItem Header="ファイル">
                <MenuItem Header="新規作成"
                  Command="{Binding CreateNewCommand}" 
                  InputGestureText="Ctrl+N" />
                <MenuItem Header="開く"
                  Command="{Binding OpenCommand}"
                  InputGestureText="Ctrl+O" />
                <MenuItem Header="保存"
                  Command="{Binding SaveCommand}" 
                  InputGestureText="Ctrl+S" />
                <MenuItem Header="名前を付けて保存"
                  Command="{Binding SaveAsCommand}"
                  InputGestureText="Ctrl+Shift+S" />

                <Separator />
                
                <MenuItem Header="終了"
                  Command="{Binding QuitCommand}" />
            </MenuItem>
        </Menu>

        <!--ToolBar-->
        <ToolBarTray Grid.Row="1">
            <ToolBar>
                <Button Command="{Binding AddChildCommand}"
                        Style="{StaticResource ToolbarButtonStyle}"
                        ToolTip="子ノードを追加">
                    <Image Style="{StaticResource ToolbarIconStyle}"
                           Source="pack://application:,,,/AsciiTreeMaker;component/Assets/Images/add-child.png"/>
                </Button>

                <Button Command="{Binding AddBrotherCommand}"
                        Style="{StaticResource ToolbarButtonStyle}"
                        ToolTip="兄弟ノードを追加">
                    <Image Style="{StaticResource ToolbarIconStyle}"
                           Source="pack://application:,,,/AsciiTreeMaker;component/Assets/Images/add-brother.png"/>
                </Button>

                <Button Command="{Binding MoveUpCommand}"
                        Style="{StaticResource ToolbarButtonStyle}"
                        ToolTip="上に移動">
                    <Image Style="{StaticResource ToolbarIconStyle}"
                           Source="pack://application:,,,/AsciiTreeMaker;component/Assets/Images/up.png"/>
                </Button>

                <Button Command="{Binding MoveDownCommand}"
                        Style="{StaticResource ToolbarButtonStyle}"
                        ToolTip="下に移動">
                    <Image Style="{StaticResource ToolbarIconStyle}"
                           Source="pack://application:,,,/AsciiTreeMaker;component/Assets/Images/down.png"/>
                </Button>

                <Button Command="{Binding RenameCommand}"
                        Style="{StaticResource ToolbarButtonStyle}"
                        ToolTip="ノード名を編集">
                    <Image Style="{StaticResource ToolbarIconStyle}"
                           Source="pack://application:,,,/AsciiTreeMaker;component/Assets/Images/rename.png"/>
                </Button>

                <Button Command="{Binding RemoveCommand}"
                        Style="{StaticResource ToolbarButtonStyle}"
                        ToolTip="ノードを削除">
                    <Image Style="{StaticResource ToolbarIconStyle}"
                           Source="pack://application:,,,/AsciiTreeMaker;component/Assets/Images/remove.png"/>
                </Button>

                <Separator/>

                <Button Command="{Binding ExpandAllCommand}"
                        Style="{StaticResource ToolbarButtonStyle}"
                        ToolTip="すべて展開">
                    <Image Style="{StaticResource ToolbarIconStyle}"
                           Source="pack://application:,,,/AsciiTreeMaker;component/Assets/Images/expand-tree.png"/>
                </Button>

                <Button Command="{Binding CollapseAllCommand}"
                        Style="{StaticResource ToolbarButtonStyle}"
                        ToolTip="すべて折りたたむ">
                    <Image Style="{StaticResource ToolbarIconStyle}"
                           Source="pack://application:,,,/AsciiTreeMaker;component/Assets/Images/collapse-tree.png"/>
                </Button>

                <Separator/>
                
                <Button Command="{Binding CopyToClipBoardCommand}" ToolTip="クリップボードにコピー">
                    <Image Style="{StaticResource ToolbarIconStyle}"
                           Source="pack://application:,,,/AsciiTreeMaker;component/Assets/Images/convert-to-text.png"/>
                </Button>

                <Separator/>

                <TextBlock Text="枝の長さ："
                           VerticalAlignment="Center"
                           Margin="6,0,4,0"/>

                <ComboBox Width="30"
                          VerticalAlignment="Center"
                          HorizontalAlignment="Right"
                          ItemsSource="{Binding BranchLengthCandidates}"
                          ToolTip="枝の長さ"
                          SelectedItem="{Binding BranchLengthValue, Mode=TwoWay}" />
            </ToolBar>
        </ToolBarTray>

        <!--TreeView-->
        <TreeView Grid.Row="2"
                  Margin="10"
                  ItemsSource="{Binding Roots}">
            <TreeView.ItemContainerStyle>
                <Style TargetType="TreeViewItem">
                    <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                    <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                </Style>
            </TreeView.ItemContainerStyle>
            
            <TreeView.Resources>
                <HierarchicalDataTemplate DataType="{x:Type models:TreeViewNode}"
                                          ItemsSource="{Binding Children}">
                    <TextBlock Text="{Binding Name.Value}" />
                </HierarchicalDataTemplate>
            </TreeView.Resources>
            <i:Interaction.Triggers>
                <i:EventTrigger EventName="SelectedItemChanged">
                    <prism:InvokeCommandAction
                        Command="{Binding TreeViewSelectionChanged}"
                        TriggerParameterPath="NewValue"/>
                </i:EventTrigger>
            </i:Interaction.Triggers>
        </TreeView>

        <StatusBar Grid.Row="3"
                   Visibility="{Binding IsDebugMode,
                                Converter={StaticResource BoolVisibilityConverter}}">
            <!-- デバッグ表示 -->
            <StatusBarItem>
                <TextBlock Text="DEBUG"
                           Background="Red"
                           Foreground="White"
                           FontWeight="Bold"
                           Padding="6,0"
                           Margin="0"/>
            </StatusBarItem>

            <!-- ノード数表示 -->
            <StatusBarItem>
                <TextBlock>
                    <Run Text="Nodes: "/>
                    <Run Text="{Binding TotalNodeCount.Value, Mode=OneWay}"/>
                </TextBlock>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
